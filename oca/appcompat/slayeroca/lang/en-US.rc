LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_ACPPAGESHEET DIALOGEX 0, 0, 224, 226
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "OCA Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT "If you have problems running this program with One-Core-API, select an operating system One-Core-API should report to the application.\nPlease note that this is a work in progress.", IDC_EXPLANATION, 7, 7, 210, 31
    GROUPBOX "Compatibility mode", IDC_COMPATGROUP, 7, 41, 210, 49
    CHECKBOX "Report a different version of Windows:", IDC_CHKRUNCOMPATIBILITY, 18, 57, 188, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    COMBOBOX IDC_COMPATIBILITYMODE, 18, 70, 188, 200, CBS_HASSTRINGS | CBS_DROPDOWNLIST | WS_TABSTOP | WS_DISABLED
    GROUPBOX "Advanced Options", -1, 7, 99, 210, 71, BS_GROUPBOX
    CHECKBOX "Enable global OS spoofing (Windows 10)", IDC_CHKDISABLEOSSPOOFING, 18, 114, 188, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    CHECKBOX "Run in 256 colors", IDC_CHKRUNIN256COLORS, 18, 129, 188, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    CHECKBOX "Run in 640x480 screen resolution", IDC_CHKRUNIN640480RES, 18, 144, 188, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    CHECKBOX "Disable visual themes", IDC_CHKDISABLEVISUALTHEMES, 18, 159, 188, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    LTEXT "",IDC_ENABLED_LAYERS,7,185,210,21
    CONTROL "Learn more about <A>program compatibility</A>.", IDC_INFOLINK, "SysLink", WS_CHILD | WS_TABSTOP | WS_VISIBLE, 7, 207, 210, 10, WS_EX_NOPARENTNOTIFY
END

IDD_EDITCOMPATIBILITYMODES DIALOGEX 0, 0, 309, 134
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Compatibility Modes"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LISTBOX         IDC_NEWCOMPATIBILITYMODE,6,18,132,90,LBS_NOINTEGRALHEIGHT | WS_VSCROLL
    LISTBOX         IDC_COMPATIBILITYMODE,168,18,132,90,LBS_NOINTEGRALHEIGHT | WS_VSCROLL
    PUSHBUTTON      ">",IDC_ADD,144,42,18,14,WS_DISABLED
    PUSHBUTTON      "<<",IDC_REMOVEALL,144,78,18,14,WS_DISABLED
    PUSHBUTTON      "<",IDC_REMOVE,144,60,18,14,WS_DISABLED
    PUSHBUTTON      "&OK",IDOK,174,114,60,14
    PUSHBUTTON      "&Cancel",IDCANCEL,240,114,60,14
    LTEXT           "Available modes",-1,6,6,52,8
    LTEXT           "Selected modes",-1,168,6,51,8
END

STRINGTABLE
BEGIN
    IDS_COMPAT_TITLE "OCA Settings"
    IDS_FAILED_NETWORK "Compatibility modes cannot be set on this program because it is on a network drive."
    IDS_FAILED_PROTECTED "Compatibility modes cannot be set on this program because it is a part of Windows."
END

